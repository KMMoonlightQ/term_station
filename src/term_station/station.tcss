Screen {
    background: #0b1119;
    color: #d8e2ed;
    padding: 0;
    margin: 0;
}
#tab-row { height: 1; padding: 0; background: #0b1119; }
#workspace-tabs { width: 1fr; height: 1; }
Tabs { background: #0b1119; }
Tabs #tabs-scroll, Tabs #tabs-list-bar, Tabs #tabs-list { height: 1; }
Tab { background: #101821; color: #7890a6; padding: 0 1; }
Tab.-active { background: #142b2b; color: #8be2cc; text-style: bold; }
Underline { display: none; }
#dashboard { height: 1fr; width: 1fr; padding: 0; overflow: hidden auto; scrollbar-size-vertical: 1; scrollbar-color: #35526b; scrollbar-background: #0b1119; }
#dashboard:empty { border: solid #26394b; }
#command-bar { dock: bottom; height: 1; width: 1fr; padding: 0 1; background: #0b1119; overflow: hidden hidden; }
.prefix-active #command-bar { background: #24281e; color: #f0b775; text-style: bold; }
Panel { background: #101821; border: solid #26394b; padding: 0; margin: 0; overflow: hidden hidden; border-title-color: #bacbdc; }
Panel:focus, Panel:focus-within { border: solid #69d5bd; }
Panel.edge-hover { border: solid #9be6d5; }
.editing Panel { border: solid #66715c; }
.editing Panel:focus, .editing Panel:focus-within, Panel.dragging { border: solid #f0b775; }
.prefix-active Panel:focus, .prefix-active Panel:focus-within { border: solid #f0b775; }
Panel.dragging { layer: overlay; }
.info-body { height: 1fr; width: 1fr; padding: 1 1 0 1; overflow: hidden hidden; }
NotesView { width: 1fr; height: 1fr; border: none; padding: 1; background: #101821; color: #a8bccd; }
NotesView:focus { border: none; }
FormScreen { align: center middle; background: #040810 75%; }
.dialog { width: 64; height: auto; max-height: 95%; border: round #426876; background: #111c28; padding: 1 2; overflow-y: auto; }
.dialog-title { text-style: bold; color: #8be2cc; height: 2; }
.dialog Label { height: auto; margin-top: 1; }
.dialog Input { background: #0b141e; border: tall #30475c; margin-bottom: 0; }
.dialog Input:focus { border: tall #69d5bd; }
.dialog-actions { height: 1; align-horizontal: right; margin-top: 1; }
.dialog Button {
    width: auto;
    min-width: 0;
    height: 1;
    margin-left: 1;
    padding: 0 1;
    border: none !important;
    background: transparent !important;
    tint: transparent !important;
    color: #bacbdc;
    text-style: none;
}
.dialog Button.-primary { color: #8be2cc; }
.dialog Button.-error { color: #ed8c96; }
.dialog Button:hover, .dialog Button:focus { text-style: bold underline; }
.help-dialog { width: 70; height: 36; max-height: 100%; }
#help-scroll { height: 1fr; scrollbar-size-vertical: 1; }
#help-content { height: auto; }
